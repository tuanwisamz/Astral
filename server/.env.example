# Copy to server/.env and fill in. Never commit server/.env.
# On Render, set these in the dashboard instead (render.yaml lists them).

APP_ENV=development                 # production on Render: turns the dev auth bypass off
DATABASE_URL=                       # Supabase session pooler, port 5432: postgresql+asyncpg://…
SUPABASE_URL=                       # https://<project>.supabase.co
SUPABASE_SERVICE_KEY=               # service role key (server only; reads and writes report photos)

CLERK_JWKS_URL=                     # https://<instance>.clerk.accounts.dev/.well-known/jwks.json
CLERK_SECRET_KEY=                   # sk_… (Admin user management, account deletion)
CLERK_AUTHORIZED_PARTIES=http://localhost:5173   # comma-separated frontend origins
CLERK_WEBHOOK_SECRET=               # optional (plan D4)

GEMINI_API_KEY=
GEMINI_MODEL_VISION=gemini-3.6-flash
GEMINI_MODEL_LITE=gemini-3.5-flash-lite
TOMTOM_API_KEY=                     # optional: the traffic job skips itself without it
REDDIT_CLIENT_ID=                   # optional
REDDIT_CLIENT_SECRET=               # optional
NOMINATIM_USER_AGENT=               # e.g. smart-analysis-road/1.0 (your-email)

CRON_SECRET=                        # any long random string; the same value goes in GitHub secrets
FRONTEND_ORIGIN=http://localhost:5173

# Local development only, and only when APP_ENV=development: act as this role without signing in.
DEV_AUTH_ROLE=
